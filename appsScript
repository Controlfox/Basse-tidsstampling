const SPREADSHEET_ID = "12ia6w2tlV0DXrJcQ5Eotv39lFxWqzp2RO7uV9qiCTCE";
const SHEET_NAME = "Blad1";
const TOKEN = "BYT_MIG_TILL_EN_LANG_SLUMP_TOKEN_BAJS"; // ⚠️ Byt ut detta!

// Vi använder kolumn L (12) för logId
const LOG_ID_COL = 12;

// Färg för dagsession (ENDAST A-H)
const DAY_BG = "#d9ead3";

function doGet(e) {
  const p = e && e.parameter ? e.parameter : {};
  if (!p.type) return json({ ok: true, message: "Apps Script is up" });
  return json(handleWrite(p));
}

function doPost(e) {
  const params = e && e.parameter ? e.parameter : {};
  let body = {};
  try {
    if (e && e.postData && e.postData.contents)
      body = JSON.parse(e.postData.contents);
  } catch (_) {}

  const p = Object.assign({}, params, body);
  if (!p.type) return json({ ok: true, message: "POST ok (no type)" });
  return json(handleWrite(p));
}

function handleWrite(p) {
  console.log("→ params:", JSON.stringify(p));
  let result;
  try {
    result = handleWriteInner(p);
  } catch (err) {
    // Sista raden av försvar: returnera ALLTID JSON så klienten slipper
    // få en HTML-500 (vilket också ger missvisande CORS-fel i browsern).
    result = {
      success: false,
      error: "Uncaught: " + String(err),
      stack: err && err.stack ? String(err.stack) : "",
    };
  }
  console.log("← result:", JSON.stringify(result));
  return result;
}

function handleWriteInner(p) {
  // Serialisera alla skrivningar — annars kan två samtidiga requesterns
  // findLastBoatRowUnderDay/insertRowAfter racea och en boatLogStop kan
  // köras innan motsvarande boatLogStart hunnit skriva sin rad.
  // getScriptLock fungerar för både standalone- och container-bound script
  // (till skillnad från getDocumentLock som returnerar null för standalone).
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(20000);
  } catch (err) {
    return { success: false, error: "Lock timeout: " + String(err) };
  }

  try {
    if (TOKEN && p.token !== TOKEN) {
      return { success: false, error: "Unauthorized (token mismatch)" };
    }

    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName(SHEET_NAME);
    if (!sheet)
      return { success: false, error: `Sheet "${SHEET_NAME}" not found` };

    const type = String(p.type);

    // --- 1) Dagsession: skapa rad direkt vid start ---
    if (type === "daySessionHeader") {
      sheet.appendRow([
        p.date || "", // A
        p.dayStartTime || "", // B
        "",
        "",
        "",
        "", // C-F
        "", // G (dayEndTime senare)
        "", // H (total duration senare)
        "",
        "",
        "",
        "", // I-L
      ]);

      const row = sheet.getLastRow();
      sheet.getRange(row, 1, 1, 8).setBackground(DAY_BG);

      return { success: true, wrote: "daySessionHeader", row };
    }

    // --- 2) Dagsession: uppdatera sluttid + totaltid (minus lunch) ---
    if (type === "updateDaySessionEndTime") {
      const dayRow = findLatestDayRow(sheet, String(p.date || ""));
      if (!dayRow)
        return { success: false, error: "No matching day session row found" };

      sheet.getRange(dayRow, 7).setValue(p.dayEndTime || ""); // G

      const minutes = calculateMinutes(p.dayStartTime, p.dayEndTime);

      const lunchMinutes = sumLunchMinutesUnderDay(sheet, dayRow);
      const netMinutes = Math.max(0, minutes - lunchMinutes);

      const durationValue = netMinutes / (24 * 60);

      const totalCell = sheet.getRange(dayRow, 8); // H
      totalCell.setValue(durationValue);
      totalCell.setNumberFormat('[h] "tim" mm "min"');

      return { success: true, updatedRow: dayRow, minutes: netMinutes };
    }

    // --- 3) Båtlogg: START (skapa rad under rätt dagsession i rätt ordning) ---
    if (type === "boatLogStart") {
      const logId = String(p.logId || "");
      if (!logId) return { success: false, error: "Missing logId" };

      const dateStr = String(p.date || "") || todayISO();

      const dayRow = findLatestDayRow(sheet, dateStr);
      // ✅ FIX: null-check på dayRow
      if (!dayRow)
        return {
          success: false,
          error: "No day session found for date: " + dateStr,
        };

      const insertAfterRow = findLastBoatRowUnderDay(sheet, dayRow);
      // ✅ FIX: null-check på insertAfterRow
      if (insertAfterRow === null)
        return { success: false, error: "Could not determine insert position" };

      sheet.insertRowAfter(insertAfterRow);
      const newRow = insertAfterRow + 1;

      const rowData = Array(12).fill("");
      rowData[2] = p.boat || ""; // C
      rowData[3] = p.startTime || ""; // D
      rowData[4] = ""; // E
      rowData[5] = ""; // F
      rowData[11] = logId; // L

      sheet.getRange(newRow, 1, 1, 12).setValues([rowData]);
      sheet.getRange(newRow, 1, 1, 8).setBackground("#ffffff");

      return {
        success: true,
        wrote: "boatLogStart",
        row: newRow,
        logId,
        dayRow,
      };
    }

    // --- 4) Båtlogg: UPDATE TIMES (uppdatera start/end via logId i kolumn L) ---
    if (type === "boatLogUpdateTimes") {
      const logId = String(p.logId || "");
      if (!logId) return { success: false, error: "Missing logId" };

      const lastRow = sheet.getLastRow();

      for (let i = lastRow; i >= 2; i--) {
        const idCell = String(sheet.getRange(i, LOG_ID_COL).getValue() || "");
        if (idCell === logId) {
          if (p.startTime !== undefined && String(p.startTime) !== "") {
            sheet.getRange(i, 4).setValue(p.startTime);
          }
          if (p.endTime !== undefined) {
            sheet.getRange(i, 5).setValue(p.endTime || "");
          }
          return { success: true, updatedRow: i, logId };
        }
      }

      return {
        success: false,
        error: "No matching boat log row found for logId",
        logId,
      };
    }

    // --- 5) Båtlogg: STOP (uppdatera samma rad via logId i kolumn L) ---
    if (type === "boatLogStop") {
      const logId = String(p.logId || "");
      if (!logId) return { success: false, error: "Missing logId" };

      const lastRow = sheet.getLastRow();

      for (let i = lastRow; i >= 2; i--) {
        const idCell = String(sheet.getRange(i, LOG_ID_COL).getValue() || "");
        if (idCell === logId) {
          sheet.getRange(i, 5).setValue(p.endTime || ""); // E
          sheet.getRange(i, 6).setValue(p.description || ""); // F
          return { success: true, updatedRow: i, logId };
        }
      }

      return {
        success: false,
        error: "No matching boat log row found for logId",
        logId,
      };
    }

    // --- Legacy: boatLog appendRow ---
    if (type === "boatLog") {
      const rowData = Array(12).fill("");
      rowData[2] = p.boat || "";
      rowData[3] = p.startTime || "";
      rowData[4] = p.endTime || "";
      rowData[5] = p.description || "";
      rowData[11] = String(p.logId || "");

      sheet.appendRow(rowData);

      const r = sheet.getLastRow();
      sheet.getRange(r, 1, 1, 8).setBackground("#ffffff");

      return { success: true, wrote: "boatLog" };
    }

    return { success: false, error: `Unknown type: ${type}` };
  } catch (err) {
    return {
      success: false,
      error: String(err),
      stack: err && err.stack ? String(err.stack) : "",
    };
  } finally {
    lock.releaseLock();
  }
}

function findLatestDayRow(sheet, dateStr) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;

  for (let i = lastRow; i >= 2; i--) {
    const dateCell = normalizeDate(sheet.getRange(i, 1).getValue()); // A
    const boatCell = String(sheet.getRange(i, 3).getValue() || ""); // C
    if (dateCell === String(dateStr) && boatCell === "") return i;
  }
  return null;
}

function findLastBoatRowUnderDay(sheet, dayRow) {
  // ✅ FIX: null-guard
  if (dayRow === null || dayRow === undefined) return null;

  const lastRow = sheet.getLastRow();
  let i = dayRow + 1;
  let last = dayRow;

  while (i <= lastRow) {
    const boatCell = String(sheet.getRange(i, 3).getValue() || "");
    if (boatCell === "") break;
    last = i;
    i++;
  }

  return last;
}

function todayISO() {
  return Utilities.formatDate(
    new Date(),
    Session.getScriptTimeZone(),
    "yyyy-MM-dd",
  );
}

function json(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(
    ContentService.MimeType.JSON,
  );
}

function normalizeDate(value) {
  if (
    Object.prototype.toString.call(value) === "[object Date]" &&
    !isNaN(value)
  ) {
    return Utilities.formatDate(
      value,
      Session.getScriptTimeZone(),
      "yyyy-MM-dd",
    );
  }
  return String(value || "");
}

function calculateMinutes(start, end) {
  const [sh, sm] = String(start || "")
    .split(":")
    .map(Number);
  const [eh, em] = String(end || "")
    .split(":")
    .map(Number);
  if ([sh, sm, eh, em].some((n) => Number.isNaN(n))) return 0;

  let diff = eh * 60 + em - (sh * 60 + sm);
  if (diff < 0) diff += 24 * 60;
  return diff;
}

// ✅ FIX: konverterar cellvärde till "HH:mm"-sträng oavsett om det är Date, decimal eller sträng
function cellToTimeStr(value) {
  if (value instanceof Date && !isNaN(value)) {
    return Utilities.formatDate(value, Session.getScriptTimeZone(), "HH:mm");
  }
  // Sheets lagrar tid som decimaltal: 0.5 = 12:00
  if (typeof value === "number" && value >= 0 && value < 1) {
    const totalMinutes = Math.round(value * 24 * 60);
    const h = Math.floor(totalMinutes / 60);
    const m = totalMinutes % 60;
    return String(h).padStart(2, "0") + ":" + String(m).padStart(2, "0");
  }
  return String(value || "").trim();
}

function sumLunchMinutesUnderDay(sheet, dayRow) {
  const lastRow = sheet.getLastRow();
  let i = dayRow + 1;
  let sum = 0;

  while (i <= lastRow) {
    const boatCell = String(sheet.getRange(i, 3).getValue() || "").trim(); // C
    if (boatCell === "") break;

    if (boatCell.toLowerCase() === "lunch") {
      // ✅ FIX: använd cellToTimeStr så att Date/decimal-värden konverteras rätt
      const start = cellToTimeStr(sheet.getRange(i, 4).getValue()); // D
      const end = cellToTimeStr(sheet.getRange(i, 5).getValue()); // E

      const mins = start && end ? calculateMinutes(start, end) : 30;
      sum += mins > 0 ? mins : 30;
    }

    i++;
  }

  return sum;
}
